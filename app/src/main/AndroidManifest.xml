<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- Lets the info sheet show photo GPS location from EXIF -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- No ads in this app: drop the advertising-ID permissions Firebase Analytics adds,
         so the Play Console "Advertising ID" declaration can simply be "No". -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />


    <application
        android:name=".PhotoEditorApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/logo_square"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/logo_round"
        android:supportsRtl="true"

        android:theme="@style/Theme.Lumina">
        <activity
            android:name=".GalleryActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustPan|stateHidden"
            android:theme="@style/Theme.Lumina">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".PhotoEditorActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:theme="@style/Theme.Lumina"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".PhotoDetailActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:theme="@style/Theme.Lumina.Viewer" />
        <activity
            android:name=".AlbumDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Lumina" />
        <activity
            android:name=".StudioActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".CollageActivity"
            android:exported="false"
            android:theme="@style/Theme.Lumina" />
        <activity
            android:name=".AiCutoutActivity"
            android:exported="false"
            android:theme="@style/Theme.Lumina" />
        <activity
            android:name=".BeforeAfterActivity"
            android:exported="false"
            android:theme="@style/Theme.Lumina" />
        <activity
            android:name=".TrashActivity"
            android:exported="false"
            android:theme="@style/Theme.Lumina" />
        <activity
            android:name=".HiddenMediaActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Lumina" />
        <activity
            android:name=".ProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.Lumina" />

        <!-- Smart tools (all on-device) -->
        <activity
            android:name=".CleanerActivity"
            android:exported="false"
            android:theme="@style/Theme.Lumina" />
        <activity
            android:name=".VideoToolsActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:theme="@style/Theme.Lumina" />
        <activity
            android:name=".PhotosToPdfActivity"
            android:exported="false"
            android:theme="@style/Theme.Lumina" />
        <activity
            android:name=".CompressActivity"
            android:exported="false"
            android:theme="@style/Theme.Lumina" />
        <activity
            android:name=".QuickFixActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:theme="@style/Theme.Lumina" />
        <activity
            android:name=".TextLensActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:theme="@style/Theme.Lumina.Viewer" />

        <!-- Shares temporary copies (e.g. photos with location removed, PDFs, GIFs) -->
        <!-- Analytics without advertising ID / ad personalisation -->
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Ask Google Play services to download the on-device ML models at install time
             (text recognition, image labeling, face detection) so the tools work offline. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr,ica,face,subject_segment" />
    </application>

</manifest>