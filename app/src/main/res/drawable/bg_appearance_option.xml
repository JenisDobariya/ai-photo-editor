<?xml version="1.0" encoding="utf-8"?>
<!-- Theme option tile in the Appearance sheet: selected = accent outline + accent container -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_l" />
            <solid android:color="?attr/appAccentContainer" />
            <stroke android:width="2dp" android:color="?attr/appAccent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_l" />
            <solid android:color="@color/lumina_surface_high" />
            <stroke android:width="1dp" android:color="@color/lumina_outline" />
        </shape>
    </item>
</selector>
