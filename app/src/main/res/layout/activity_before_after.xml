<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lumina_bg">

    <!-- Top Navigation Bar -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            style="@style/Widget.App.TopBarIcon"
            android:id="@+id/btnBack"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_chevron_left" />

        <TextView
            style="@style/Widget.App.HeaderTitle"
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@+id/headerActions"
            android:layout_toEndOf="@id/btnBack"
            android:text="Before &amp; After" />

        <LinearLayout
            android:id="@+id/headerActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnSwapTop"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@drawable/ic_swap_horiz"
                app:tint="@color/white" />

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.App.HeaderAction"
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:text="Save" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Canvas Preview Area -->
    <FrameLayout
        android:id="@+id/canvasContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_preview_rounded"
        android:clipToOutline="true"
        app:layout_constraintBottom_toTopOf="@id/controlContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <com.photo_editor.my_photo_editor.ui.BeforeAfterView
            android:id="@+id/beforeAfterView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/lumina_gold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Bottom Controls Area -->
    <LinearLayout
        android:id="@+id/controlContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#12131A"
        android:orientation="vertical"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Sheet Drag Indicator -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_slider_track" />

        <!-- Tool Sub-Tabs Row (Horizontal Scroll) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabSplitMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="🔀 Layout"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabRatio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="📐 Ratio"
                    android:textColor="@color/lumina_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tabBadges"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="🏷️ Badges"
                    android:textColor="@color/lumina_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tabStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="🎨 Style"
                    android:textColor="@color/lumina_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tabReplace"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="🔄 Photos"
                    android:textColor="@color/lumina_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Subtle Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="#1F2433" />

        <!-- Sub-Panel 1: Split Modes Horizontal Recycler -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSplitModes"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:scrollbars="none"
            android:visibility="visible" />

        <!-- Sub-Panel 2: Ratios Horizontal Recycler -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRatios"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:scrollbars="none"
            android:visibility="gone" />

        <!-- Sub-Panel 3: Badges Panel -->
        <LinearLayout
            android:id="@+id/panelBadges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:visibility="gone">

            <!-- Badge Style Row -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnBadgeDark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_chip_selected"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="Dark Pill"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnBadgeGold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="Gold Accent"
                        android:textColor="@color/lumina_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/btnBadgeMinimal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="Minimal"
                        android:textColor="@color/lumina_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/btnBadgeHide"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_unselected"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="Hide"
                        android:textColor="@color/lumina_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Badge Text Preset Row -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnPresetBeforeAfter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_chip_selected"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:text="BEFORE / AFTER"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnPresetOriginalEdited"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:text="ORIGINAL / EDITED"
                        android:textColor="@color/lumina_text_secondary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/btnPresetRawRetouch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_unselected"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:text="RAW / RETOUCH"
                        android:textColor="@color/lumina_text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Sub-Panel 4: Style Adjustments (Thickness, Color, Radius) -->
        <LinearLayout
            android:id="@+id/panelStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:visibility="gone">

            <!-- Thickness Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Line"
                    android:textColor="@color/lumina_text_secondary"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/sbThickness"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="12"
                    android:progress="3"
                    android:progressDrawable="@drawable/seekbar_track"
                    android:splitTrack="false"
                    android:thumb="@drawable/seekbar_thumb" />

                <TextView
                    android:id="@+id/tvThicknessValue"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="3dp"
                    android:textColor="@color/lumina_gold"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Corner Radius Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Radius"
                    android:textColor="@color/lumina_text_secondary"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/sbRadius"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="32"
                    android:progress="16"
                    android:progressDrawable="@drawable/seekbar_track"
                    android:splitTrack="false"
                    android:thumb="@drawable/seekbar_thumb" />

                <TextView
                    android:id="@+id/tvRadiusValue"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="16dp"
                    android:textColor="@color/lumina_gold"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Line Colors Recycler -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvLineColors"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:scrollbars="none" />
        </LinearLayout>

        <!-- Sub-Panel 5: Replace Photos & Quick Swap -->
        <LinearLayout
            android:id="@+id/panelReplace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="6dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReplaceBefore"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Before Photo"
                android:textColor="@color/white"
                android:textSize="11sp"
                app:cornerRadius="@dimen/radius_m"
                app:icon="@drawable/ic_replace"
                app:iconSize="14dp"
                app:iconTint="@color/white"
                app:strokeColor="#334155" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReplaceAfter"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="After Photo"
                android:textColor="@color/white"
                android:textSize="11sp"
                app:cornerRadius="@dimen/radius_m"
                app:icon="@drawable/ic_replace"
                app:iconSize="14dp"
                app:iconTint="@color/white"
                app:strokeColor="#334155" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSwapAction"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:backgroundTint="@color/lumina_surface"
                android:paddingHorizontal="14dp"
                android:text="Swap"
                android:textColor="@color/lumina_gold"
                android:textSize="11sp"
                app:cornerRadius="@dimen/radius_m"
                app:icon="@drawable/ic_swap_horiz"
                app:iconSize="16dp"
                app:iconTint="@color/lumina_gold" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
