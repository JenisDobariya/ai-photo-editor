<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Custom Top Bar -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="sans-serif-medium"
            android:text="Studio"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@id/btnSave"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnUndo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_undo"
                app:tint="@color/white"
                android:alpha="0.4"
                android:enabled="false" />

            <ImageButton
                android:id="@+id/btnRedo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_redo"
                app:tint="@color/white"
                android:alpha="0.4"
                android:enabled="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackground"
            android:padding="8dp"
            android:text="Save"
            android:textColor="@color/lumina_gold"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Preview Container -->
    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_preview_rounded"
        android:clipToOutline="true"
        app:layout_constraintBottom_toTopOf="@+id/controlsContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <ImageView
            android:id="@+id/photoPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />

        <FrameLayout
            android:id="@+id/layersContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.photo_editor.my_photo_editor.ui.DrawingView
            android:id="@+id/drawingView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <com.photo_editor.my_photo_editor.ui.CropOverlayView
            android:id="@+id/cropOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Floating Compare Button -->
    <LinearLayout
        android:id="@+id/btnCompare"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_pill_dark"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@id/controlsContainer"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_compare" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Compare"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Controls Container -->
    <FrameLayout
        android:id="@+id/controlsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000000"
        app:layout_constraintBottom_toTopOf="@id/bottomModeNav">

        <!-- Filter Controls -->
        <LinearLayout
            android:id="@+id/filterControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp"
            android:visibility="visible">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/filterList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                tools:listitem="@layout/item_filter" />

            <!-- Intensity Area -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INTENSITY"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvFilterIntensityValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="100%"
                        android:textColor="@color/lumina_gold"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:clipToOutline="true">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/bg_slider_track" />

                    <View
                        android:id="@+id/filterSliderProgress"
                        android:layout_width="0dp"
                        android:layout_height="12dp"
                        android:layout_gravity="center_vertical|start"
                        android:layout_marginStart="0dp"
                        android:background="@drawable/bg_adjustment_progress" />

                    <SeekBar
                        android:id="@+id/filterIntensitySlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:max="100"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:progress="100"
                        android:progressDrawable="@android:color/transparent"
                        android:thumb="@drawable/bg_slider_thumb"
                        android:thumbOffset="0dp" />

                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Adjustment Controls -->
        <LinearLayout
            android:id="@+id/adjustmentControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/adjustmentPicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                tools:listitem="@layout/item_adjustment" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:paddingHorizontal="16dp"
                android:clipToOutline="true">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/bg_slider_track" />

                <View
                    android:id="@+id/adjustmentSliderProgress"
                    android:layout_width="0dp"
                    android:layout_height="12dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_adjustment_progress" />

                <SeekBar
                    android:id="@+id/adjustmentSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:max="200"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:progress="100"
                    android:progressDrawable="@android:color/transparent"
                    android:thumb="@drawable/bg_slider_thumb"
                    android:thumbOffset="0dp" />

            </FrameLayout>
        </LinearLayout>

        <!-- Crop Controls -->
        <LinearLayout
            android:id="@+id/cropControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnRotate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_back"
                        android:rotation="-90" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rotate"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnMirror"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_compare" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mirror"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnCropAction"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_crop" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Crop"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Auto, Straighten, Vertical, Horizontal row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnCropAuto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_circle_accent"
                        android:gravity="center"
                        android:text="AUTO"
                        android:textColor="#000000"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Auto"
                        android:textColor="#808080"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnStraighten"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_pill_dark"
                        android:padding="16dp"
                        android:src="@drawable/ic_tune" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Straighten"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnCropVertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_pill_dark"
                        android:padding="16dp"
                        android:src="@drawable/ic_markup" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Vertical"
                        android:textColor="#808080"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnCropHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_pill_dark"
                        android:padding="16dp"
                        android:src="@drawable/ic_compare" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Horizontal"
                        android:textColor="#808080"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Straighten Ruler -->
            <com.photo_editor.my_photo_editor.ui.StraightenRulerView
                android:id="@+id/straightenRuler"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="24dp" />

            <!-- Aspect Ratio List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/ratioList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Markup Controls -->
        <LinearLayout
            android:id="@+id/markupControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_pill_dark"
            android:elevation="8dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/controlsContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:id="@+id/toolPen"
                android:layout_width="32dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_tool_pen" />

            <ImageView
                android:id="@+id/toolPencil"
                android:layout_width="32dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_tool_pencil" />

            <ImageView
                android:id="@+id/toolHighlighter"
                android:layout_width="32dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_tool_highlighter" />

            <ImageView
                android:id="@+id/toolFountain"
                android:layout_width="32dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_tool_fountain" />

            <ImageView
                android:id="@+id/toolEraser"
                android:layout_width="32dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_tool_eraser" />

            <View
                android:layout_width="1dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="10dp"
                android:background="#444444" />

            <View
                android:id="@+id/btnMarkupColor"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_color_picker_ring" />
        </LinearLayout>

        <!-- Text Controls -->
        <LinearLayout
            android:id="@+id/textControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#12131A"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <!-- Sheet Drag Indicator -->
            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_slider_track" />

            <!-- Input Row: Pill Input Box + Add Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_text_input_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_text"
                        app:tint="@color/lumina_text_secondary" />

                    <EditText
                        android:id="@+id/etTextInput"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:background="@android:color/transparent"
                        android:hint="Type something..."
                        android:imeOptions="actionDone"
                        android:inputType="textCapSentences"
                        android:maxLines="1"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#64748B"
                        android:textSize="14sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddText"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:backgroundTint="@color/lumina_gold"
                    android:paddingHorizontal="16dp"
                    android:text="Add"
                    android:textColor="#000000"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="22dp"
                    app:icon="@drawable/ic_check"
                    app:iconTint="#000000"
                    app:iconSize="16dp" />
            </LinearLayout>

            <!-- Text Sub-Tabs Row (Fonts, Colors, Adjust, Effects) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tabFontStyles"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_selected"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:text="🔤 Font"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tabTextColors"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:text="🎨 Color"
                        android:textColor="@color/lumina_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tabTextAdjust"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:text="📏 Adjust"
                        android:textColor="@color/lumina_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tabTextEffects"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_unselected"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:text="✨ Effects"
                        android:textColor="@color/lumina_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Subtle Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="#1F2433" />

            <!-- Sub-Panel 1: Font Styles Horizontal RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/fontPicker"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:scrollbars="none" />

            <!-- Sub-Panel 2: Colors Horizontal RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/textColorPicker"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:scrollbars="none"
                android:visibility="gone" />

            <!-- Sub-Panel 3: Size, Opacity, Align & Format Controls -->
            <LinearLayout
                android:id="@+id/panelTextAdjust"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:visibility="gone">

                <!-- Text Size Slider Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="54dp"
                        android:layout_height="wrap_content"
                        android:text="Size"
                        android:textColor="@color/lumina_text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium" />

                    <SeekBar
                        android:id="@+id/textSizeSlider"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="72"
                        android:min="12"
                        android:progress="28"
                        android:progressDrawable="@drawable/seekbar_track"
                        android:thumb="@drawable/seekbar_thumb"
                        android:splitTrack="false" />

                    <TextView
                        android:id="@+id/tvTextSizeValue"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="28sp"
                        android:textColor="@color/lumina_gold"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Text Opacity Slider Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="54dp"
                        android:layout_height="wrap_content"
                        android:text="Opacity"
                        android:textColor="@color/lumina_text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium" />

                    <SeekBar
                        android:id="@+id/textOpacitySlider"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100"
                        android:min="10"
                        android:progress="100"
                        android:progressDrawable="@drawable/seekbar_track"
                        android:thumb="@drawable/seekbar_thumb"
                        android:splitTrack="false" />

                    <TextView
                        android:id="@+id/tvTextOpacityValue"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="100%"
                        android:textColor="@color/lumina_gold"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Align & Format Buttons Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnAlignLeft"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:text="⇤ Left"
                        android:textColor="@color/lumina_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/btnAlignCenter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_chip_selected"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:text="≡ Center"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnAlignRight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:text="⇥ Right"
                        android:textColor="@color/lumina_text_secondary"
                        android:textSize="11sp" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="10dp"
                        android:background="#2A303C" />

                    <TextView
                        android:id="@+id/btnBold"
                        android:layout_width="34dp"
                        android:layout_height="30dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="B"
                        android:textColor="@color/lumina_text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnItalic"
                        android:layout_width="34dp"
                        android:layout_height="30dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="I"
                        android:textColor="@color/lumina_text_secondary"
                        android:textSize="13sp"
                        android:textStyle="italic" />

                    <TextView
                        android:id="@+id/btnAllCaps"
                        android:layout_width="34dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="aA"
                        android:textColor="@color/lumina_text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Sub-Panel 4: Effects (Shadow Presets & Badges) -->
            <LinearLayout
                android:id="@+id/panelTextEffects"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Shadow Presets Horizontal RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/shadowPresetPicker"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:scrollbars="none" />

                <!-- Subtle Inner Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp"
                    android:background="#1F2433" />

                <!-- Badges Horizontal RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/textBadgePicker"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:scrollbars="none" />
            </LinearLayout>

        </LinearLayout>

        <!-- Stickers Controls -->
        <LinearLayout
            android:id="@+id/stickersControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#12131A"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <!-- Sheet Drag Indicator -->
            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_slider_track" />

            <!-- Category Tabs List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/stickerCategoryRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingBottom="8dp" />

            <!-- Subtle Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="12dp"
                android:layout_marginBottom="6dp"
                android:background="#1F2433" />

            <!-- Sticker Grid / Custom Container -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="210dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/stickerPicker"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingHorizontal="8dp"
                    android:paddingBottom="16dp"
                    android:scrollbars="none" />

                <!-- Custom Sticker Pick View -->
                <LinearLayout
                    android:id="@+id/customStickerContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/btnPickCustomSticker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_studio_card_surface"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_add_photo"
                            app:tint="@color/lumina_accent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Choose from Gallery"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Add transparent PNG or photo as sticker"
                            android:textColor="@color/lumina_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

            </FrameLayout>
        </LinearLayout>

        <!-- Watermark Controls -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/watermarkPicker"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:padding="8dp"
            android:visibility="gone" />

        <!-- Pixelate Controls -->
        <LinearLayout
            android:id="@+id/pixelateControls"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:gravity="center"
            android:padding="16dp"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pixelate Area (Soon)"
                android:textColor="#808080" />
        </LinearLayout>

    </FrameLayout>



    <!-- Bottom Mode Navigation -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/bottomModeNav"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="#000000"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:listitem="@layout/item_editor_mode" />

</androidx.constraintlayout.widget.ConstraintLayout>
