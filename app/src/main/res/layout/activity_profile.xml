            <!-- Support Section -->
            <TextView
                style="@style/ProfileSectionHeader"
                android:text="@string/profile_support" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/lumina_surface"
                app:cardCornerRadius="@dimen/radius_m"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp">

                    <include
                        android:id="@+id/itemUpdateApp"
                        layout="@layout/view_profile_item" />

                    <include
                        android:id="@+id/itemRateUs"
                        layout="@layout/view_profile_item" />

                    <include
                        android:id="@+id/itemShare"
                        layout="@layout/view_profile_item" />

                    <include
                        android:id="@+id/itemFeedback"
                        layout="@layout/view_profile_item" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- About Section -->
            <TextView
                style="@style/ProfileSectionHeader"
                android:layout_marginTop="20dp"
                android:text="@string/profile_about" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/lumina_surface"
                app:cardCornerRadius="@dimen/radius_m"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp">

                    <include
                        android:id="@+id/itemPrivacy"
                        layout="@layout/view_profile_item" />

                    <include
                        android:id="@+id/itemPlayStore"
                        layout="@layout/view_profile_item" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/tvVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Version 1.0.0"
                    android:textColor="@color/lumina_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Made with ❤️"
                    android:textColor="@color/lumina_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

        </LinearLayout>
