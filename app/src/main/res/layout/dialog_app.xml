<?xml version="1.0" encoding="utf-8"?>
<!-- AppDialog: the one dialog layout used across the app (see ui/AppDialog.kt). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_app_dialog"
    android:orientation="vertical"
    android:paddingTop="22dp"
    android:paddingBottom="14dp">

    <!-- Header: optional tinted icon disc + title -->
    <LinearLayout
        android:id="@+id/dialogHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="22dp">

        <FrameLayout
            android:id="@+id/dialogIconWrap"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="14dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/dialogIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:id="@+id/dialogTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/lumina_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Video saved" />
    </LinearLayout>

    <!-- Body scrolls if it is taller than the screen (weight shrinks it, header and buttons stay) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/dialogBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fadeScrollbars="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dialogMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:paddingHorizontal="22dp"
                android:textColor="@color/lumina_text_secondary"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="Your original was not changed."
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/dialogRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="22dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_app_dialog_rows"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/dialogItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/dialogCustom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Buttons, right-aligned: neutral, negative, then the main action (filled) -->
    <LinearLayout
        android:id="@+id/dialogButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dialogNeutral"
            style="@style/Widget.App.DialogButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/appAccent"
            android:visibility="gone"
            tools:text="Share"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dialogNegative"
            style="@style/Widget.App.DialogButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:textColor="@color/lumina_text_secondary"
            android:visibility="gone"
            tools:text="Done"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dialogPositive"
            style="@style/Widget.App.DialogButton.Filled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:visibility="gone"
            tools:text="Open"
            tools:visibility="visible" />
    </LinearLayout>
</LinearLayout>
