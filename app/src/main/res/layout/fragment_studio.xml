<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lumina_bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="20dp">

            <!-- Clean up hero: live status of the on-device photo analysis -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCleanup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/radius_l"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_studio_hero"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvCleanupBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tag"
                        android:letterSpacing="0.08"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="ON-DEVICE · PRIVATE"
                        android:textColor="?attr/appAccentSoft"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <FrameLayout
                        android:id="@+id/cleanupIconWrap"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_smart_album_icon"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_g_cleanup"
                            app:tint="@color/lumina_teal" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvCleanupTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="12dp"
                        android:fontFamily="sans-serif-black"
                        android:text="Clean up your gallery"
                        android:textColor="@color/lumina_text_strong"
                        android:textSize="21sp"
                        app:layout_constraintEnd_toStartOf="@id/cleanupIconWrap"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvCleanupBadge" />

                    <TextView
                        android:id="@+id/tvCleanupStats"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="2dp"
                        android:text="Finds duplicates, similar shots, blurry photos &amp; big videos"
                        android:textColor="@color/lumina_text_secondary"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvCleanupTitle" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressCleanup"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:visibility="gone"
                        app:indicatorColor="?attr/appAccent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvCleanupStats"
                        app:trackColor="@color/studio_progress_track"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStartCleanup"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="?attr/appAccent"
                        android:text="Start clean up"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="@dimen/radius_m"
                        app:icon="@drawable/ic_chevron_right"
                        app:iconGravity="end"
                        app:iconSize="18dp"
                        app:iconTint="@color/white"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/progressCleanup" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Smart tools: one panel, 4 × 2 icon grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Smart tools"
                    android:textColor="@color/lumina_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="Free · offline · private"
                    android:textColor="@color/lumina_text_tertiary"
                    android:textSize="12sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSmartTools"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_surface"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:padding="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Create"
                android:textColor="@color/lumina_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- Card 1: Collage Maker (Featured Card) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCollage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="@dimen/radius_l"
                app:cardElevation="6dp"
                app:strokeColor="?attr/appAccent"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_studio_card_accent"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_tag"
                            android:letterSpacing="0.08"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="POPULAR"
                            android:textColor="?attr/appAccentSoft"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_collage_grid"
                            app:tint="@color/lumina_text_strong" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="sans-serif-black"
                        android:text="Collage Maker"
                        android:textColor="@color/lumina_text_strong"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp"
                        android:text="Combine 2 to 9 photos into custom grid layouts with adjustable borders, corner radius, and canvas aspect ratios."
                        android:textColor="@color/studio_card_text"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCreateCollage"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="?attr/appAccent"
                        android:text="Create Collage"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        app:cornerRadius="@dimen/radius_m"
                        app:icon="@drawable/ic_collage_grid"
                        app:iconTint="@color/white" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: AI Cutout & Blur -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAiCutout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="@dimen/radius_l"
                app:cardElevation="3dp"
                app:strokeColor="@color/lumina_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_studio_card_surface"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_tag"
                            android:letterSpacing="0.08"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="AI POWERED"
                            android:textColor="?attr/appAccentSoft"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_magic_wand"
                            app:tint="?attr/appAccentSoft" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="sans-serif-black"
                        android:text="AI Cutout &amp; Blur"
                        android:textColor="@color/lumina_text_strong"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp"
                        android:text="Isolate subjects on-device, generate transparent PNG stickers, or apply professional DSLR portrait bokeh blur."
                        android:textColor="@color/lumina_text_secondary"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTryCutout"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginTop="16dp"
                        android:text="Try Cutout"
                        android:textColor="@color/lumina_text_strong"
                        android:textSize="13sp"
                        app:cornerRadius="@dimen/radius_m"
                        app:icon="@drawable/ic_magic_wand"
                        app:iconTint="@color/lumina_text_strong"
                        app:strokeColor="@color/studio_button_stroke" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: Before & After Showcase -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBeforeAfter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="@dimen/radius_l"
                app:cardElevation="3dp"
                app:strokeColor="@color/lumina_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_studio_card_surface"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_tag"
                            android:letterSpacing="0.08"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="SHOWCASE"
                            android:textColor="?attr/appAccentSoft"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_compare"
                            app:tint="@color/studio_sky" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="sans-serif-black"
                        android:text="Before &amp; After"
                        android:textColor="@color/lumina_text_strong"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp"
                        android:text="Create clean side-by-side split cards to demonstrate photo edits, color grading, and retouches."
                        android:textColor="@color/lumina_text_secondary"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCreateComparison"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginTop="16dp"
                        android:text="Create Split"
                        android:textColor="@color/lumina_text_strong"
                        android:textSize="13sp"
                        app:cornerRadius="@dimen/radius_m"
                        app:icon="@drawable/ic_compare"
                        app:iconTint="@color/lumina_text_strong"
                        app:strokeColor="@color/studio_button_stroke" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
