<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="8dp">

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp">

        <!-- Progress Ring (Hidden when not active) -->
        <com.photo_editor.my_photo_editor.ui.AdjustmentCircleView
            android:id="@+id/adjustmentProgress"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            tools:visibility="visible" />

        <FrameLayout
            android:id="@+id/iconContainer"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_adjustment_item">

            <ImageView
                android:id="@+id/ivAdjustmentIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_exposure" />

            <!-- Value Text Overlay (Like -28) -->
            <TextView
                android:id="@+id/tvAdjustmentValueOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_adjustment_overlay"
                android:gravity="center"
                android:textColor="?attr/appAccentSoft"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="-28"
                tools:visibility="visible" />
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/tvAdjustmentName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Exposure"
        android:textColor="#FFFFFF"
        android:textSize="10sp" />

</LinearLayout>
