<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="6dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivAlbumCover"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/lumina_surface"
            android:scaleType="centerCrop"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.Rounded18" />

        <TextView
            android:id="@+id/tvAlbumBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:background="@drawable/bg_badge_dark"
            android:drawablePadding="4dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_g_video"
            app:drawableTint="@color/white"
            app:layout_constraintBottom_toBottomOf="@id/ivAlbumCover"
            app:layout_constraintEnd_toEndOf="@id/ivAlbumCover"
            tools:text="12"
            tools:visibility="visible" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tvAlbumName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="2dp"
        android:textColor="@color/lumina_text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="Camera" />

    <TextView
        android:id="@+id/tvAlbumCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="2dp"
        android:textColor="@color/lumina_text_secondary"
        android:textSize="12sp"
        tools:text="1,204 items" />
</LinearLayout>
