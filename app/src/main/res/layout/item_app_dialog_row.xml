<?xml version="1.0" encoding="utf-8"?>
<!-- One label / value row in AppDialog's detail block. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/rowLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.36"
        android:textColor="@color/lumina_text_tertiary"
        android:textSize="13sp"
        tools:text="Location" />

    <TextView
        android:id="@+id/rowValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.64"
        android:textColor="@color/lumina_text_primary"
        android:textIsSelectable="true"
        android:textSize="13sp"
        tools:text="Movies/PhotoEditor" />
</LinearLayout>
