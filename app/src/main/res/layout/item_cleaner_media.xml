<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="2dp">

    <ImageView
        android:id="@+id/iv_thumb"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_cl_thumb"
        android:contentDescription="Preview"
        android:foreground="?attr/selectableItemBackground"
        android:outlineProvider="background"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/selected_frame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_cl_selected_frame"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/iv_thumb"
        app:layout_constraintEnd_toEndOf="@id/iv_thumb"
        app:layout_constraintStart_toStartOf="@id/iv_thumb"
        app:layout_constraintTop_toTopOf="@id/iv_thumb"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_best"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="6dp"
        android:background="@drawable/bg_cl_badge_best"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:text="Best"
        android:textColor="@color/lumina_bg"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/iv_thumb"
        app:layout_constraintTop_toTopOf="@id/iv_thumb"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/iv_video"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_margin="6dp"
        android:contentDescription="Video"
        android:src="@drawable/ic_g_video"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/iv_thumb"
        app:layout_constraintBottom_toBottomOf="@id/iv_thumb"
        app:tint="@color/white"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:background="@drawable/bg_cl_badge_info"
        android:maxLines="1"
        android:paddingHorizontal="5dp"
        android:paddingVertical="1dp"
        android:textColor="@color/white"
        android:textSize="10sp"
        android:textStyle="bold"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@id/iv_thumb"
        app:layout_constraintEnd_toStartOf="@id/iv_video"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@id/iv_thumb"
        tools:text="4.2 MB" />

    <!-- 40dp touch target for the checkbox; the visible circle is 24dp -->
    <FrameLayout
        android:id="@+id/check_touch"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Select"
        app:layout_constraintEnd_toEndOf="@id/iv_thumb"
        app:layout_constraintTop_toTopOf="@id/iv_thumb">

        <ImageView
            android:id="@+id/iv_check"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_cl_check_scrim"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_g_circle_outline"
            app:tint="@color/white" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
