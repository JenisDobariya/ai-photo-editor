<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/lumina_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="18dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/iv_header_select"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="Select group"
        android:src="@drawable/ic_g_circle_outline"
        android:visibility="gone"
        app:tint="@color/lumina_text_secondary"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/lumina_text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="Today" />

    <TextView
        android:id="@+id/tvHeaderCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/lumina_text_tertiary"
        android:textSize="12sp"
        tools:text="24 items" />
</LinearLayout>
