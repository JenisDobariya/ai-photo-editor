<?xml version="1.0" encoding="utf-8"?>
<!-- Options card shown under the page grid (full width item of the pages list). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="6dp"
    android:paddingTop="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_surface"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Page size"
            android:textColor="@color/lumina_text_secondary"
            android:textSize="13sp" />
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_size_a4"
                style="@style/Widget.App.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A4"
                app:chipIconVisible="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_size_letter"
                style="@style/Widget.App.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Letter"
                app:chipIconVisible="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_size_fit"
                style="@style/Widget.App.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fit to photo"
                app:chipIconVisible="false" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:id="@+id/label_orientation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-medium"
            android:text="Orientation"
            android:textColor="@color/lumina_text_secondary"
            android:textSize="13sp" />
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_orientation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_orient_auto"
                style="@style/Widget.App.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Auto"
                app:chipIconVisible="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_orient_portrait"
                style="@style/Widget.App.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Portrait"
                app:chipIconVisible="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_orient_landscape"
                style="@style/Widget.App.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Landscape"
                app:chipIconVisible="false" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:id="@+id/tv_orientation_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Each page takes the shape of its photo"
            android:textColor="@color/lumina_text_tertiary"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-medium"
            android:text="Margin"
            android:textColor="@color/lumina_text_secondary"
            android:textSize="13sp" />
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_margin_none"
                style="@style/Widget.App.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="None"
                app:chipIconVisible="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_margin_small"
                style="@style/Widget.App.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Small"
                app:chipIconVisible="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_margin_large"
                style="@style/Widget.App.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Large"
                app:chipIconVisible="false" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-medium"
            android:text="Quality"
            android:textColor="@color/lumina_text_secondary"
            android:textSize="13sp" />
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_quality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_quality_standard"
                style="@style/Widget.App.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Standard · 150 dpi"
                app:chipIconVisible="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_quality_high"
                style="@style/Widget.App.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="High · 300 dpi"
                app:chipIconVisible="false" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-medium"
            android:text="File name"
            android:textColor="@color/lumina_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/row_file_name"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_pdf_field"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/tv_file_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textColor="@color/lumina_text_primary"
                android:textSize="15sp"
                tools:text="Photos_20261122_1030.pdf" />

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="Rename"
                android:padding="6dp"
                android:src="@drawable/ic_pdf_edit"
                app:tint="?attr/appAccent" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Saved to Documents/PhotoEditor"
            android:textColor="@color/lumina_text_tertiary"
            android:textSize="12sp" />

    </LinearLayout>
</FrameLayout>
