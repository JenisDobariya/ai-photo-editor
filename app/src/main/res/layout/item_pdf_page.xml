<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="6dp">

    <FrameLayout
        android:id="@+id/page_frame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_pdf_page"
        android:elevation="2dp"
        android:padding="4dp"
        app:layout_constraintDimensionRatio="H,5:7"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Page"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_page_number"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_margin="6dp"
        android:background="@drawable/bg_pdf_badge"
        android:elevation="3dp"
        android:gravity="center"
        android:minWidth="20dp"
        android:paddingHorizontal="6dp"
        android:textColor="@color/lumina_text_primary"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/page_frame"
        app:layout_constraintStart_toStartOf="@id/page_frame" />

    <ImageView
        android:id="@+id/btn_remove_page"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_margin="2dp"
        android:background="@drawable/bg_pdf_remove"
        android:contentDescription="Remove page"
        android:elevation="3dp"
        android:padding="6dp"
        android:src="@drawable/ic_g_close"
        app:layout_constraintEnd_toEndOf="@id/page_frame"
        app:layout_constraintTop_toTopOf="@id/page_frame"
        app:tint="@color/lumina_text_primary" />

</androidx.constraintlayout.widget.ConstraintLayout>
