<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mediaContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.photo_editor.my_photo_editor.ui.ZoomableImageView
        android:id="@+id/ivMainPhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:shutter_background_color="@android:color/transparent"
        app:use_controller="false"
        app:surface_type="texture_view" />

    <ProgressBar
        android:id="@+id/videoProgressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:visibility="gone"
        android:indeterminateTint="?attr/appAccent" />

    <ImageView
        android:id="@+id/ivPlayVideo"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_icon_button_scrim"
        android:padding="18dp"
        android:src="@drawable/ic_g_slideshow"
        android:visibility="gone"
        app:tint="@color/white" />

    <!-- Shown when this phone's video decoder can't play the file (e.g. 4K on a 1080p chip) -->
    <LinearLayout
        android:id="@+id/videoUnsupported"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="28dp"
        android:background="@drawable/bg_app_dialog"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_g_info"
            app:tint="?attr/appAccentSoft" />

        <TextView
            android:id="@+id/tvUnsupportedTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Can't play this video"
            android:textColor="@color/lumina_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvUnsupportedDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/lumina_text_secondary"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUnsupportedOpenWith"
            style="@style/Widget.App.DialogButton.Filled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Open with another app" />
    </LinearLayout>

</FrameLayout>
