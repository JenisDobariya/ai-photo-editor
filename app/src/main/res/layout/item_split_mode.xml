<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/modeRoot"
    android:layout_width="92dp"
    android:layout_height="80dp"
    android:layout_marginEnd="8dp"
    android:background="@drawable/bg_font_card_unselected"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <ImageView
        android:id="@+id/ivModeIcon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_compare"
        app:tint="@color/lumina_text_secondary" />

    <TextView
        android:id="@+id/tvModeName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="Slider"
        android:textColor="@color/lumina_text_secondary"
        android:textSize="11sp" />

</LinearLayout>
