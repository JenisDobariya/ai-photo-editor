<?xml version="1.0" encoding="utf-8"?>
<!-- One Smart tool in the Studio grid (4 per row): Albums-style icon tile + label. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_studio_tool_ripple"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="2dp"
    android:paddingTop="12dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp">

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_smart_album_icon">

            <ImageView
                android:id="@+id/ivToolIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                app:tint="?attr/appAccent"
                tools:src="@drawable/ic_t_scan" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvToolBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_studio_ai_badge"
            android:paddingHorizontal="5dp"
            android:paddingVertical="1dp"
            android:textColor="@color/white"
            android:textSize="8sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="AI"
            tools:visibility="visible" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvToolTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center_horizontal|top"
        android:lineSpacingExtra="1dp"
        android:maxLines="2"
        android:minLines="2"
        android:textColor="@color/lumina_text_primary"
        android:textSize="12sp"
        tools:text="Scan document" />
</LinearLayout>
