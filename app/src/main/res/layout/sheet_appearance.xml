<?xml version="1.0" encoding="utf-8"?>
<!-- Profile → Appearance: theme (System / Light / Dark) and accent colour. See ui/AppearanceBottomSheet. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/lumina_surface"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Appearance"
        android:textColor="@color/lumina_text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Theme"
        android:textColor="@color/lumina_text_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/optSystem"
            style="@style/Widget.App.AppearanceOption"
            android:layout_marginEnd="8dp"
            android:text="System"
            app:drawableTopCompat="@drawable/ic_g_theme" />

        <TextView
            android:id="@+id/optLight"
            style="@style/Widget.App.AppearanceOption"
            android:layout_marginEnd="8dp"
            android:text="Light"
            app:drawableTopCompat="@drawable/ic_g_light_mode" />

        <TextView
            android:id="@+id/optDark"
            style="@style/Widget.App.AppearanceOption"
            android:text="Dark"
            app:drawableTopCompat="@drawable/ic_g_dark_mode" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Accent colour"
        android:textColor="@color/lumina_text_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <GridLayout
        android:id="@+id/accentGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:columnCount="5" />

    <TextView
        android:id="@+id/tvAccentName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:textColor="@color/lumina_text_secondary"
        android:textSize="13sp" />
</LinearLayout>
