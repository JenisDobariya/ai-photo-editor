<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="@color/lumina_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp">

    <ImageView
        android:id="@+id/btnCloseSelection"
        style="@style/Widget.App.TopBarIcon"
        android:contentDescription="Cancel selection"
        android:src="@drawable/ic_g_close" />

    <TextView
        android:id="@+id/tvSelectionCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:textColor="@color/lumina_text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:text="3 selected" />

    <ImageView
        android:id="@+id/btnSelectAll"
        style="@style/Widget.App.TopBarIcon"
        android:contentDescription="Select all"
        android:src="@drawable/ic_g_select_all" />
</LinearLayout>
