<?xml version="1.0" encoding="utf-8"?>
<!-- MX-style playback panel shown above the viewer actions while a video page is open:
     seek row (tap the right time to switch total / remaining), then
     Lock · Previous · Play/Pause · Next · Fit. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <TextView
            android:id="@+id/tvPosition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:minWidth="40dp"
            android:textColor="@color/white"
            android:textSize="13sp"
            tools:text="0:12" />

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:max="1000"
            android:maxHeight="3dp"
            android:minHeight="3dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:progressDrawable="@drawable/video_seek_progress"
            android:splitTrack="false"
            android:thumb="@drawable/video_seek_thumb"
            android:thumbOffset="8dp" />

        <TextView
            android:id="@+id/tvDuration"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:fontFeatureSettings="tnum"
            android:gravity="end|center_vertical"
            android:minWidth="48dp"
            android:textColor="@color/white"
            android:textSize="13sp"
            tools:text="-3:45" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnLock"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Lock screen"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_v_lock" />

        <ImageButton
            android:id="@+id/btnPrev"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Previous"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_v_prev" />

        <ImageButton
            android:id="@+id/btnPlayPause"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Play or pause"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_v_pause" />

        <ImageButton
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Next"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_v_next" />

        <ImageButton
            android:id="@+id/btnAspect"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Fit or fill screen"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_v_aspect" />
    </LinearLayout>
</LinearLayout>
