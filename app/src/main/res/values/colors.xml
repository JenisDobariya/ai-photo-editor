<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!--
        LIGHT theme palette. The dark palette (unchanged) lives in values-night/colors.xml with the
        same names, so every screen switches automatically with the Light / Dark / System setting.
        Photo/video viewers and editors always use the dark palette (BaseActivity.alwaysDark).
        Accent colours come from ?attr/appAccent (user-selectable); the lumina_accent* values below
        are only the Blue defaults.
    -->
    <color name="lumina_bg">#F6F7F9</color>
    <color name="lumina_surface">#FFFFFF</color>
    <color name="lumina_surface_high">#EEF1F5</color>
    <color name="lumina_surface_highest">#E3E7ED</color>
    <color name="lumina_outline">#DDE2E9</color>
    <color name="lumina_search_bg">#ECEFF3</color>
    <color name="lumina_accent">#1A66D6</color>
    <color name="lumina_accent_outline">#591A66D6</color>
    <color name="lumina_accent_dim">#331A66D6</color>
    <color name="lumina_accent_container">#DFEAF9</color>
    <color name="lumina_on_accent_container">#0E3876</color>
    <color name="lumina_gold">#185EC5</color>
    <color name="lumina_gold_dim">#33185EC5</color>
    <color name="lumina_text_primary">#15181D</color>
    <!-- pure white text in dark (as before), dark text in light -->
    <color name="lumina_text_strong">#15181D</color>
    <color name="lumina_text_secondary">#5A6370</color>
    <color name="lumina_text_tertiary">#8B939E</color>
    <color name="lumina_chip_unselected">#EEF1F5</color>
    <color name="lumina_favorite">#E0356B</color>
    <color name="lumina_teal">#0E9484</color>
    <color name="lumina_danger">#D6363C</color>
    <!-- Studio tool tints -->
    <color name="studio_violet">#7A5AF0</color>
    <color name="studio_amber">#C97C06</color>
    <color name="lumina_scrim">#B3000000</color>
    <color name="lumina_scrim_light">#66000000</color>
    <color name="lumina_selection_overlay">#661A66D6</color>
    <color name="lumina_bar_translucent">#E6F6F7F9</color>

    <!-- Studio cards (fragment_studio): dark values = the original literals -->
    <color name="studio_card_text">#4A5361</color>
    <color name="studio_button_stroke">#B4BCC7</color>
    <color name="studio_sky">#0280BE</color>
    <color name="studio_progress_track">#1F000000</color>

    <!-- Legacy names kept for existing screens -->
    <color name="darkBlue">#FFFFFF</color>
    <color name="lightBlue">#185EC5</color>
    <color name="blue">#1A66D6</color>
    <color name="app_bg_blue">#F6F7F9</color>
    <color name="lightNevyBlue">#EEF1F5</color>
    <color name="background_app">#F6F7F9</color>
    <color name="logo_color">#1A66D6</color>
    <color name="transparent">#00000000</color>

    <!-- Bottom-sheet navigation bar. Black before Android 8 (API 26): those versions can't draw
         dark navigation-bar icons, so the white buttons need a dark bar (values-v26 = surface). -->
    <color name="lumina_sheet_nav_bar">#000000</color>
</resources>
