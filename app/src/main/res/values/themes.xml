<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Photo_Editor" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.Photo_Editor" parent="Base.Theme.Photo_Editor" />

    <!-- Light / dark base: values/ = light, values-night/ = dark (the original look).
         Light, Dark or System is chosen in Profile → Appearance (utils/ThemePreferences). -->
    <style name="Base.Theme.Lumina" parent="Theme.Material3.Light.NoActionBar">
        <!-- softer press/ripple highlight on light backgrounds (dark keeps the default) -->
        <item name="colorControlHighlight">#1A15181D</item>
        <item name="android:colorControlHighlight">#1A15181D</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Theme.Lumina" parent="Base.Theme.Lumina">
        <!-- Accent roles: Blue defaults; ThemeOverlay.Accent.* replaces them (user choice) -->
        <item name="appAccent">@color/lumina_accent</item>
        <item name="appAccentSoft">@color/lumina_gold</item>
        <item name="appAccentContainer">@color/lumina_accent_container</item>
        <item name="appOnAccentContainer">@color/lumina_on_accent_container</item>
        <item name="appAccentDim">@color/lumina_accent_dim</item>
        <item name="appSelectionOverlay">@color/lumina_selection_overlay</item>
        <item name="appAccentOutline">@color/lumina_accent_outline</item>
        <item name="android:windowBackground">@color/lumina_bg</item>
        <item name="colorPrimary">?attr/appAccent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">?attr/appAccentContainer</item>
        <item name="colorOnPrimaryContainer">?attr/appOnAccentContainer</item>
        <item name="colorSecondary">?attr/appAccent</item>
        <item name="colorSecondaryContainer">?attr/appAccentContainer</item>
        <item name="colorOnSecondaryContainer">?attr/appOnAccentContainer</item>
        <item name="colorTertiary">?attr/appAccentSoft</item>
        <item name="colorError">@color/lumina_danger</item>
        <item name="android:colorBackground">@color/lumina_bg</item>
        <item name="colorSurface">@color/lumina_surface</item>
        <item name="colorOnSurface">@color/lumina_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/lumina_text_secondary</item>
        <item name="colorSurfaceVariant">@color/lumina_surface_high</item>
        <item name="colorSurfaceContainerLowest">@color/lumina_bg</item>
        <item name="colorSurfaceContainerLow">@color/lumina_surface</item>
        <item name="colorSurfaceContainer">@color/lumina_surface</item>
        <item name="colorSurfaceContainerHigh">@color/lumina_surface_high</item>
        <item name="colorSurfaceContainerHighest">@color/lumina_surface_highest</item>
        <item name="colorOutline">@color/lumina_outline</item>
        <item name="colorOutlineVariant">@color/lumina_outline</item>
        <item name="android:statusBarColor">@color/lumina_bg</item>
        <item name="android:navigationBarColor">@color/lumina_bg</item>

        <!-- Bottom Nav Overrides -->
        <item name="bottomNavigationStyle">@style/Widget.App.BottomNavigationView</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.App.BottomSheetDialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.MaterialAlertDialog</item>
        <item name="popupMenuStyle">@style/Widget.App.PopupMenu</item>
        <!-- Material shape scale mapped to the app's three corner sizes -->
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.App.Small</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.App.Medium</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.App.Large</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.App.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.App.Large</item>
        <!-- Material 3 buttons default to full pills; use the app's control radius instead -->
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.App.Button.Outlined</item>
        <item name="borderlessButtonStyle">@style/Widget.App.Button.Text</item>
        <!-- android.widget.PopupMenu (used by the More menus) reads the framework attributes -->
        <item name="android:popupMenuStyle">@style/Widget.App.PopupMenu.Framework</item>
        <item name="android:textAppearanceLargePopupMenu">@style/TextAppearance.App.PopupMenu</item>
        <item name="android:textAppearanceSmallPopupMenu">@style/TextAppearance.App.PopupMenu</item>
    </style>

    <style name="Widget.App.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.BottomNavigationView</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.App.BottomNavigationView.ActiveIndicator</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.App.BottomNav</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.App.BottomNav.Active</item>
        <!-- Compact MX-style bar: 56dp tall, no pill, colour marks the selected tab -->
        <item name="android:minHeight">56dp</item>
        <item name="itemPaddingTop">7dp</item>
        <item name="itemPaddingBottom">7dp</item>
        <item name="itemRippleColor">?attr/appAccentDim</item>
    </style>

    <style name="ThemeOverlay.App.BottomNavigationView" parent="">
        <item name="colorSurfaceContainer">@color/lumina_surface</item>
    </style>

    <style name="Widget.App.BottomNavigationView.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
        <item name="android:height">28dp</item>
    </style>

    <style name="TextAppearance.App.BottomNav" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.App.BottomNav.Active" parent="TextAppearance.App.BottomNav">
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Bottom sheets: rounded top, surface colored -->
    <style name="ThemeOverlay.App.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.App.BottomSheet</item>
        <item name="android:navigationBarColor">@color/lumina_surface</item>
    </style>

    <style name="Widget.App.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@color/lumina_surface</item>
        <item name="shapeAppearance">@style/ShapeAppearanceOverlay.App.Card.TopRounded</item>
    </style>

    <!-- Dialogs -->
    <style name="ThemeOverlay.App.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/lumina_surface_high</item>
        <item name="colorSurfaceContainerHigh">@color/lumina_surface_high</item>
        <item name="colorPrimary">?attr/appAccent</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.App.Dialog</item>
    </style>

    <!-- AppDialog (ui/AppDialog.kt): the app's one dialog look. The card itself is
         bg_app_dialog; the window is transparent so only the rounded card shows. -->
    <style name="ThemeOverlay.App.Dialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="android:backgroundDimAmount">0.62</item>
        <item name="android:windowAnimationStyle">@style/Animation.App.Dialog</item>
        <item name="colorPrimary">?attr/appAccent</item>
        <item name="colorAccent">?attr/appAccent</item>
        <item name="colorSurface">@color/lumina_surface_high</item>
        <item name="android:textColorPrimary">@color/lumina_text_primary</item>
    </style>

    <style name="Animation.App.Dialog" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/app_dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/app_dialog_exit</item>
    </style>

    <style name="Widget.App.DialogButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:maxLines">1</item>
        <item name="cornerRadius">@dimen/radius_m</item>
    </style>

    <style name="Widget.App.DialogButton.Filled" parent="Widget.Material3.Button">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">?attr/appAccent</item>
        <item name="cornerRadius">@dimen/radius_m</item>
    </style>

    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.App.Medium</item>
    </style>

    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="shapeAppearance">@style/ShapeAppearance.App.Medium</item>
    </style>

    <style name="Widget.App.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="shapeAppearance">@style/ShapeAppearance.App.Medium</item>
    </style>

    <style name="ShapeAppearance.App.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_s</item>
    </style>

    <style name="ShapeAppearance.App.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_m</item>
    </style>

    <style name="ShapeAppearance.App.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_l</item>
    </style>

    <style name="ShapeAppearance.App.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_l</item>
    </style>

    <style name="Widget.App.PopupMenu.Framework" parent="@android:style/Widget.Material.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
        <item name="android:popupElevation">10dp</item>
        <!-- MX-style: opens over its button, kept off the screen edge -->
        <item name="android:overlapAnchor">true</item>
        <item name="android:dropDownHorizontalOffset">-12dp</item>
        <item name="android:dropDownVerticalOffset">4dp</item>
    </style>

    <style name="TextAppearance.App.PopupMenu" parent="@android:style/TextAppearance.Material.Widget.PopupMenu.Large">
        <item name="android:textColor">@color/lumina_text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.App.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
    </style>

    <!-- Gallery: filter chips -->
    <style name="Widget.App.FilterChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg_selector</item>
        <item name="android:textColor">@color/chip_text_selector</item>
        <item name="chipIconTint">@color/chip_text_selector</item>
        <item name="checkedIconTint">?attr/appOnAccentContainer</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStrokeColor">@color/chip_stroke_selector</item>
        <item name="chipCornerRadius">@dimen/radius_m</item>
        <item name="chipMinHeight">36dp</item>
        <item name="android:textSize">13sp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconVisible">true</item>
        <item name="chipIconSize">16dp</item>
        <item name="chipStartPadding">10dp</item>
        <item name="chipEndPadding">12dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.Card.TopRounded" parent="">
        <item name="cornerSizeTopLeft">@dimen/radius_l</item>
        <item name="cornerSizeTopRight">@dimen/radius_l</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.Rounded12" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_m</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.Rounded18" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_l</item>
    </style>

    <style name="ProfileSectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/appAccentSoft</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <!-- Gallery top bar icon button -->
    <!-- Screen header title next to the back chevron (all sub-screens use this). -->
    <style name="Widget.App.HeaderTitle" parent="">
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/lumina_text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Main action in a screen header (Save, Export...): same size and colour everywhere. -->
    <style name="Widget.App.HeaderAction" parent="Widget.App.DialogButton.Filled">
        <item name="android:layout_height">40dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="backgroundTint">@color/header_action_bg</item>
    </style>

    <!-- Theme option tile (System / Light / Dark) in the Appearance sheet -->
    <style name="Widget.App.AppearanceOption" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_appearance_option</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/appearance_option_text</item>
        <item name="drawableTint">@color/appearance_option_text</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.App.TopBarIcon" parent="">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">@color/lumina_text_primary</item>
    </style>

    <!-- Viewer / selection action button (icon above label) -->
    <style name="Widget.App.ActionItem" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="TextAppearance.App.ActionLabel" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/lumina_text_secondary</item>
        <item name="android:layout_marginTop">4dp</item>
    </style>

    <style name="TextAppearance.App.SectionTitle" parent="">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/lumina_text_primary</item>
    </style>
    <!-- Full-screen viewer. Opaque before Android 11, where an activity can't switch
         between translucent and opaque (needed for the video rotate button). -->
    <style name="Theme.Lumina.Viewer" parent="Theme.Lumina">
        <item name="android:windowBackground">@color/black</item>
    </style>
</resources>
